{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "./backend/dist",
    "rootDir": "./backend/src"
  },
  "include": ["backend/src/**/*"],
  "exclude": ["node_modules"]
}
