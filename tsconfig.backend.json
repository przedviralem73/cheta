{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "outDir": "./backend/dist",
    "rootDir": "./backend/src",
    "types": ["node"]
  },
  "include": ["backend/src/**/*"],
  "exclude": ["node_modules"]
}
